# Salin file ini menjadi `.env` lalu sesuaikan nilainya:
#   PowerShell : Copy-Item .env.example .env
#   Git Bash   : cp .env.example .env
#
# Hanya berisi konfigurasi NON-RAHASIA.
# Kredensial Firebase / API key TIDAK boleh ditaruh di sini.

# Base URL REST API.
# 10.0.2.2 = localhost komputer saat dilihat dari emulator Android.
API_BASE_URL=http://10.0.2.2:8000/api
